# Copy to .env.local (local) and add the same names in Vercel:
# Project > Settings > Environment Variables. Never commit the real values.

# Fine-grained personal access token.
#   Resource owner:     thergishere-wp
#   Repository access:  All repositories
#   Permissions:        Metadata (read) and Contents (read). Nothing else.
GITHUB_TOKEN=

GITHUB_USER=thergishere-wp

# Optional. Points the API calls somewhere else, e.g. the local test server
# started by `npm run mock:github`. Leave unset in production.
# GITHUB_API_URL=http://127.0.0.1:4010
